PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=3211
PLATFORM_DATA_DIR=/root/.local/share/wxbot-platform
PLATFORM_ADMIN_USERNAME=admin
# First start only. Replace with a random password of at least 10 characters.
PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
PLATFORM_MODEL=gpt-6.1-sol
PLATFORM_CODEX_BIN=/root/.local/share/wxbot-platform-tools/node_modules/.bin/codex
PLATFORM_CODEX_AUTH=/root/.codex/auth.json
# 可选：同一账号持续维护的登录文件。仅采用过期时间更新的同账号凭据。
# PLATFORM_CODEX_AUTH_SOURCE=/path/to/maintained/auth.json
PLATFORM_BWRAP=/root/.local/bin/bwrap
# For a trusted HTTPS reverse proxy, set the exact public origin:
# PLATFORM_PUBLIC_URL=https://assistants.example.com
